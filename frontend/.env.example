# Where the Spring Boot service is. Server-side only; never exposed to the browser.
PORTAL_API_URL=http://localhost:8081

# Until Keycloak is wired: a token minted against the API's development secret
# (MOAUM_AUTH_HMAC_SECRET on the API), naming a person and the offices they hold.
# See api/README.md, "Minting a development token".
PORTAL_API_TOKEN=

# The office this frontend acts as, when the request does not say.
PORTAL_ACTIVE_OFFICE=academic
